        <label class="chip"><input type="checkbox" name="tag" value="you're overthinking it"><span>you're overthinking it</span></label>
        <label class="chip"><input type="checkbox" name="tag" value="this is cute"><span>this is cute</span></label>
        <label class="chip"><input type="checkbox" name="tag" value="certified nerd"><span>bro stop nerding</span></label>
        <label class="chip"><input type="checkbox" name="tag" value="fewer charts please"><span>I like you</span></label>
      </div>
    </section>

    <section class="pan pan-pink">
      <p class="eyebrow">Would you recommend him</p>
      <div class="chips">
        <label class="chip"><input type="radio" name="rec" value="yes"><span>yes</span></label>
        <label class="chip"><input type="radio" name="rec" value="with notes"><span>with notes</span></label>
        <label class="chip"><input type="radio" name="rec" value="ask me in person"><span>ask me in person</span></label>
      </div>
    </section>

    <section class="pan pan-orange">
      <p class="eyebrow">Anything else</p>
      <textarea id="f-note" name="note" rows="4" placeholder="say it here"></textarea>
    </section>

    <section class="pan pan-olive span-all">
      <button type="submit" class="submit">Send &#8599;</button>
      <p class="err" id="f-err" hidden>Move the slider or write something first.</p>
    </section>
  </form>

  <section class="pan pan-olive" id="fb-done" hidden>
    <p class="hero small">noted. he will treasure it.</p>
  </section>

  <nav class="pan foot">
    <button type="button" class="link" data-go="model">&#8598; Back to the sliders</button>
  </nav>
</main>

<script src="script.js"></script>
</body>
</html>

